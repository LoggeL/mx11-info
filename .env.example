# Use new credentials. Never reuse the previously published keys.
# Set these in the deployment environment, or an ignored .env.local for local use.
ADMIN_PASSWORD=
PELICAN_URL=https://pelican.mx11.org
PELICAN_APP_KEY=
PELICAN_CLIENT_KEY=
CRAFTY_URL=https://crafty.mx11.org
CRAFTY_KEY=
IMMICH_URL=https://immich.mx11.org
IMMICH_SHARE_KEY=
IMMICH_ALBUM_ID=
YOUTUBE_API_KEY=
YOUTUBE_PLAYLIST_ID=
# Optional. Defaults to ./data; mount /app/data persistently in Docker.
MX11_DATA_DIR=
# Optional fixed public origin when running behind a reverse proxy.
APP_ORIGIN=
# Optional VPN hosts for infrastructure and Minecraft probes.
MX11_PRIMARY_HOST=
MX11_SECONDARY_HOST=
MX11_DATACENTER_HOST=
# Optional Uptime Kuma status page for the service health overview.
STATUS_URL=https://status.mx11.org
STATUS_PAGE_SLUG=service
