{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-hooks",
    "nextjs"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "nextjs/no-img-element": "off",
    "react/set-state-in-effect": "off",
    "react/exhaustive-deps": "error"
  },
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "data/**",
    "next-env.d.ts"
  ]
}
